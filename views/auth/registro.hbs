<div class="row justify-content-center mt-5">
    <div class="col-md-8 col-lg-5">

        <div class="card shadow-sm">
            <div class="card-header text-center">
                <h1 class="h4 mb-0"><i class="bi bi-book-half me-1"></i>Biblioteca</h1>
                <p class="text-secondary mb-0 mt-2">Crear una cuenta</p>
            </div>

            <div class="card-body">

                {{> errores}}

                {{> formularioUsuario accion="/registro" boton="Registrarme" cancelar="/login"}}

                <p class="text-center text-secondary small mt-4 mb-0">
                    ¿Ya tenés cuenta? <a href="/login">Iniciá sesión</a>
                </p>
            </div>
        </div>

    </div>
</div>
