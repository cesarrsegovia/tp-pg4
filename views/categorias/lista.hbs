{{> encabezado titulo="Categorías" subtitulo="Administración de categorías de libros" urlNuevo="/categorias/nueva" textoNuevo="Nueva categoría"}}

{{> buscador action="/categorias" placeholder="Buscar por nombre de la categoría..."}}

<div class="card shadow-sm">
    <div class="card-body">
        {{#if categorias.length}}
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle" id="tabla-categorias">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 5rem;">#</th>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    {{#each categorias}}
                    <tr>
                        <td class="text-secondary">{{id_categoria}}</td>
                        <td><i class="bi bi-bookmark text-secondary me-1"></i> {{nombre}}</td>
                        <td class="text-secondary">{{#if descripcion}}{{descripcion}}{{else}}—{{/if}}</td>
                        <td>
                            <div class="d-flex flex-wrap justify-content-end gap-2">
                                <a href="/categorias/{{id_categoria}}/editar" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil-square me-1"></i>Editar
                                </a>

                                <form
                                    action="/categorias/{{id_categoria}}/eliminar"
                                    method="POST"
                                    data-confirmar="¿Querés eliminar la categoría {{nombre}}?">
{{> csrf}}
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash me-1"></i>Eliminar
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>

        {{else}}
        <div class="alert alert-info mb-0">
            <i class="bi bi-info-circle me-1"></i>{{#if buscar}}No se encontraron resultados para "{{buscar}}".{{else}}Todavía no hay registros cargados.{{/if}}
        </div>
        {{/if}}
    </div>
</div>

{{> paginacion}}
