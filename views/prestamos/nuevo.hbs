<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="mb-4">
            <h1 class="h2 mb-1">Nuevo préstamo</h1>
            <p class="text-secondary mb-0">Seleccioná el socio y hasta 3 ejemplares disponibles.</p>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                {{> errores}}

                {{#unless socios.length}}
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-1"></i>No hay socios activos: no se pueden registrar préstamos.
                </div>
                {{/unless}}

                {{#unless ejemplares.length}}
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-1"></i>No hay ejemplares disponibles para prestar.
                </div>
                {{/unless}}

                <form action="/prestamos" method="POST" id="formularioPrestamo">
{{> csrf}}
                    <div class="row g-3">
                        <div class="col-12">
                            <label for="id_socio" class="form-label">Socio</label>
                            <select id="id_socio" name="id_socio" class="form-select" required>
                                <option value="">Seleccione un socio</option>
                                {{#each socios}}
                                <option value="{{id_socio}}">{{apellido}}, {{nombre}} - DNI: {{dni}}</option>
                                {{/each}}
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label for="fecha_prestamo" class="form-label">Fecha del préstamo</label>
                            <input type="date" id="fecha_prestamo" name="fecha_prestamo" class="form-control"
                                value="{{hoy}}" min="{{fechaMinima}}" max="{{hoy}}" required>
                            <div class="form-text">Por defecto es hoy; no puede ser posterior a hoy.</div>
                        </div>

                        <div class="col-md-6">
                            <label for="vencimiento" class="form-label">Fecha de vencimiento</label>
                            <input type="text" id="vencimiento" class="form-control" readonly tabindex="-1">
                            <div class="form-text">Se calcula sola: 7 días después del préstamo.</div>
                        </div>

                        <div class="col-12">
                            <label for="id_ejemplar_1" class="form-label">Ejemplar 1</label>
                            <select id="id_ejemplar_1" name="id_ejemplar_1" class="form-select" required>
                                <option value="">Seleccione un ejemplar</option>
                                {{#each ejemplares}}
                                <option value="{{id_ejemplar}}">{{codigo_inventario}} - {{titulo}}</option>
                                {{/each}}
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label for="id_ejemplar_2" class="form-label">Ejemplar 2 <span class="text-secondary">(opcional)</span></label>
                            <select id="id_ejemplar_2" name="id_ejemplar_2" class="form-select">
                                <option value="">Ninguno</option>
                                {{#each ejemplares}}
                                <option value="{{id_ejemplar}}">{{codigo_inventario}} - {{titulo}}</option>
                                {{/each}}
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label for="id_ejemplar_3" class="form-label">Ejemplar 3 <span class="text-secondary">(opcional)</span></label>
                            <select id="id_ejemplar_3" name="id_ejemplar_3" class="form-select">
                                <option value="">Ninguno</option>
                                {{#each ejemplares}}
                                <option value="{{id_ejemplar}}">{{codigo_inventario}} - {{titulo}}</option>
                                {{/each}}
                            </select>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Crear préstamo
                        </button>

                        <a href="/prestamos" class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg me-1"></i>Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

<script>
    // Un mismo ejemplar no puede elegirse dos veces: se deshabilita en los otros selectores.
    (function () {
        var selectores = document.querySelectorAll('#formularioPrestamo select[name^="id_ejemplar_"]');

        function actualizar() {
            var elegidos = [];

            selectores.forEach(function (s) { if (s.value) { elegidos.push(s.value); } });

            selectores.forEach(function (s) {
                Array.prototype.forEach.call(s.options, function (opcion) {
                    opcion.disabled = opcion.value !== '' &&
                        opcion.value !== s.value &&
                        elegidos.indexOf(opcion.value) !== -1;
                });
            });
        }

        selectores.forEach(function (s) { s.addEventListener('change', actualizar); });
        actualizar();

        // Vencimiento = fecha del préstamo + 7 días (solo informativo; lo calcula el servidor).
        var campoFecha = document.getElementById('fecha_prestamo');
        var campoVencimiento = document.getElementById('vencimiento');

        function mostrarVencimiento() {
            var partes = campoFecha.value.split('-');

            if (partes.length !== 3) { campoVencimiento.value = ''; return; }

            var d = new Date(Date.UTC(+partes[0], +partes[1] - 1, +partes[2] + 7));

            campoVencimiento.value =
                ('0' + d.getUTCDate()).slice(-2) + '/' +
                ('0' + (d.getUTCMonth() + 1)).slice(-2) + '/' + d.getUTCFullYear();
        }

        campoFecha.addEventListener('input', mostrarVencimiento);
        mostrarVencimiento();
    })();
</script>
