{{> encabezado titulo="Detalle del préstamo" subtitulo="Información completa del préstamo y sus ejemplares"}}

<div class="card shadow-sm mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0">Préstamo #{{prestamo.id_prestamo}}</h2>
        <span class="badge text-bg-{{claseEstado prestamo.estado}} fs-6">{{prestamo.estado}}</span>
    </div>

    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4 col-lg-3">Socio</dt>
            <dd class="col-sm-8 col-lg-9">{{prestamo.socio_apellido}}, {{prestamo.socio_nombre}}</dd>

            <dt class="col-sm-4 col-lg-3">DNI</dt>
            <dd class="col-sm-8 col-lg-9">{{prestamo.dni}}</dd>

            <dt class="col-sm-4 col-lg-3">Fecha de préstamo</dt>
            <dd class="col-sm-8 col-lg-9">{{fecha prestamo.fecha_prestamo}}</dd>

            <dt class="col-sm-4 col-lg-3">Fecha de vencimiento</dt>
            <dd class="col-sm-8 col-lg-9">{{fecha prestamo.fecha_vencimiento}}</dd>

            <dt class="col-sm-4 col-lg-3">Fecha de devolución</dt>
            <dd class="col-sm-8 col-lg-9 mb-0">{{fecha prestamo.fecha_devolucion}}</dd>
        </dl>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header">
        <h2 class="h5 mb-0"><i class="bi bi-upc-scan me-1"></i>Ejemplares</h2>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Código</th>
                        <th>Libro</th>
                        <th>Autor</th>
                        <th>Categoría</th>
                        <th class="text-center">Días de atraso</th>
                        <th class="text-end">Multa</th>
                    </tr>
                </thead>

                <tbody>
                    {{#each detalles}}
                    <tr>
                        <td class="fw-semibold">{{codigo_inventario}}</td>
                        <td>{{titulo}}</td>
                        <td>{{autor}}</td>
                        <td>{{categoria}}</td>
                        <td class="text-center">{{dias_atraso}}</td>
                        <td class="text-end">{{moneda multa}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>

    <div class="card-footer d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Total de multa</span>
        <span class="fs-5 fw-bold {{#if totalMulta}}text-danger{{/if}}">{{moneda totalMulta}}</span>
    </div>
</div>

<a href="/prestamos" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-left me-1"></i>Volver a préstamos
</a>
