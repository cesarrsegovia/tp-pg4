{{> encabezado titulo="Préstamos" subtitulo="Gestión de préstamos de la biblioteca" urlNuevo="/prestamos/nuevo" textoNuevo="Nuevo préstamo"}}

<div class="card shadow-sm mb-4">
    <div class="card-header">
        <h2 class="h6 mb-0"><i class="bi bi-funnel me-1"></i>Filtros</h2>
    </div>

    <div class="card-body">
        <form action="/prestamos" method="GET" class="row g-3">
            <div class="col-md-3">
                <label for="estado" class="form-label">Estado</label>
                <select name="estado" id="estado" class="form-select">
                    <option value="">Todos</option>
                    {{#each estados}}
                    <option value="{{valor}}" {{#if seleccionado}}selected{{/if}}>{{valor}}</option>
                    {{/each}}
                </select>
            </div>

            <div class="col-md-3">
                <label for="id_socio" class="form-label">Socio</label>
                <select name="id_socio" id="id_socio" class="form-select">
                    <option value="">Todos</option>
                    {{#each sociosFiltro}}
                    <option value="{{id_socio}}" {{#if seleccionado}}selected{{/if}}>{{nombre}} {{apellido}}</option>
                    {{/each}}
                </select>
            </div>

            <div class="col-md-3">
                <label for="fechaDesde" class="form-label">Desde</label>
                <input type="date" name="fechaDesde" id="fechaDesde" class="form-control" value="{{fechaDesde}}">
            </div>

            <div class="col-md-3">
                <label for="fechaHasta" class="form-label">Hasta</label>
                <input type="date" name="fechaHasta" id="fechaHasta" class="form-control" value="{{fechaHasta}}">
            </div>

            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel me-1"></i>Filtrar
                </button>

                <a href="/prestamos" class="btn btn-outline-secondary">
                    <i class="bi bi-x-lg me-1"></i>Limpiar
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        {{#if prestamos.length}}
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Préstamo</th>
                        <th>Socio</th>
                        <th>DNI</th>
                        <th>Fecha</th>
                        <th>Vencimiento</th>
                        <th>Libros</th>
                        <th class="text-center">Ejemplares</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    {{#each prestamos}}
                    <tr>
                        <td class="fw-semibold">#{{id_prestamo}}</td>
                        <td>{{apellido}}, {{nombre}}</td>
                        <td>{{dni}}</td>
                        <td>{{fecha fecha_prestamo}}</td>
                        <td>{{fecha fecha_vencimiento}}</td>
                        <td class="small">{{libros}}</td>
                        <td class="text-center">{{cantidad_ejemplares}}</td>
                        <td>
                            <span class="badge text-bg-{{claseEstado estado}}">{{estado}}</span>
                        </td>
                        <td>
                            <div class="d-flex flex-wrap justify-content-end gap-2">
                                <a href="/prestamos/{{id_prestamo}}" class="btn btn-sm btn-outline-info">
                                    <i class="bi bi-eye me-1"></i>Ver detalle
                                </a>

                                {{#if puedeDevolver}}
                                <a href="/prestamos/{{id_prestamo}}/devolver" class="btn btn-sm btn-outline-success">
                                    <i class="bi bi-box-arrow-in-down me-1"></i>Devolver
                                </a>
                                {{/if}}
                            </div>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="alert alert-info mb-0">
            <i class="bi bi-info-circle me-1"></i>No se encontraron préstamos.
        </div>
        {{/if}}
    </div>
</div>

{{> paginacion}}
