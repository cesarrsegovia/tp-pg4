{{> encabezado titulo="Registrar devolución" subtitulo="Indicá en qué estado vuelve cada ejemplar"}}

<div class="card shadow-sm mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0">Préstamo #{{prestamo.id_prestamo}}</h2>
        <span class="badge text-bg-{{claseEstado prestamo.estado}} fs-6">{{prestamo.estado}}</span>
    </div>

    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4 col-lg-3">Socio</dt>
            <dd class="col-sm-8 col-lg-9">{{prestamo.apellido}}, {{prestamo.nombre}} (DNI {{prestamo.dni}})</dd>

            <dt class="col-sm-4 col-lg-3">Fecha de préstamo</dt>
            <dd class="col-sm-8 col-lg-9">{{fecha prestamo.fecha_prestamo}}</dd>

            <dt class="col-sm-4 col-lg-3">Fecha de vencimiento</dt>
            <dd class="col-sm-8 col-lg-9 mb-0">{{fecha prestamo.fecha_vencimiento}}</dd>
        </dl>
    </div>
</div>

<form action="/prestamos/{{prestamo.id_prestamo}}/devolver" method="POST">
{{> csrf}}
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h2 class="h5 mb-0"><i class="bi bi-upc-scan me-1"></i>Ejemplares a devolver</h2>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Código</th>
                            <th>Libro</th>
                            <th style="min-width: 14rem;">Estado al devolver</th>
                        </tr>
                    </thead>

                    <tbody>
                        {{#each detalles}}
                        <tr>
                            <td class="fw-semibold">{{codigo_inventario}}</td>
                            <td>{{titulo}}</td>
                            <td>
                                <select
                                    name="estado_{{id_ejemplar}}"
                                    class="form-select form-select-sm"
                                    aria-label="Estado del ejemplar {{codigo_inventario}}">
                                    <option value="Disponible" selected>Disponible (en buen estado)</option>
                                    <option value="Dañado">Dañado</option>
                                    <option value="En mantenimiento">En mantenimiento</option>
                                </select>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>

            <div class="form-text mt-2">
                Los días de atraso y la multa ($500 por día y por ejemplar) se calculan automáticamente al confirmar.
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">
            <i class="bi bi-box-arrow-in-down me-1"></i>Registrar devolución
        </button>

        <a href="/prestamos" class="btn btn-outline-secondary">
            <i class="bi bi-x-lg me-1"></i>Cancelar
        </a>
    </div>
</form>
