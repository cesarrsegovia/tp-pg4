{{> encabezado titulo="Historial del ejemplar" subtitulo="Préstamos registrados para esta copia"}}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4 col-lg-3">Código de inventario</dt>
            <dd class="col-sm-8 col-lg-9">{{ejemplar.codigo_inventario}}</dd>

            <dt class="col-sm-4 col-lg-3">Libro</dt>
            <dd class="col-sm-8 col-lg-9">{{libro.titulo}}</dd>

            <dt class="col-sm-4 col-lg-3">Autor</dt>
            <dd class="col-sm-8 col-lg-9">{{libro.autor}}</dd>

            <dt class="col-sm-4 col-lg-3">Categoría</dt>
            <dd class="col-sm-8 col-lg-9">{{libro.categoria}}</dd>

            <dt class="col-sm-4 col-lg-3">Estado actual</dt>
            <dd class="col-sm-8 col-lg-9 mb-0"><span class="badge text-bg-{{claseEstado ejemplar.estado}}">{{ejemplar.estado}}</span></dd>
        </dl>
    </div>
</div>

{{#if historial}}
<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Préstamo</th>
                        <th>Socio</th>
                        <th>Fecha préstamo</th>
                        <th>Vencimiento</th>
                        <th>Devolución</th>
                        <th>Estado</th>
                        <th class="text-center">Días atraso</th>
                        <th class="text-end">Multa</th>
                    </tr>
                </thead>

                <tbody>
                    {{#each historial}}
                    <tr>
                        <td class="fw-semibold">#{{id_prestamo}}</td>
                        <td>{{apellido}}, {{nombre}}</td>
                        <td>{{fecha fecha_prestamo}}</td>
                        <td>{{fecha fecha_vencimiento}}</td>
                        <td>{{fecha fecha_devolucion}}</td>
                        <td><span class="badge text-bg-{{claseEstado estado}}">{{estado}}</span></td>
                        <td class="text-center">{{dias_atraso}}</td>
                        <td class="text-end">{{moneda multa}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</div>
{{else}}
<div class="alert alert-info">
    <i class="bi bi-info-circle me-1"></i>Este ejemplar todavía no tiene historial de préstamos.
</div>
{{/if}}

<div class="mt-3">
    <a href="/ejemplares" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Volver a ejemplares
    </a>
</div>
