<div class="row justify-content-center">
    <div class="col-lg-9">

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <div class="text-center">
                    <i class="bi bi-check-circle-fill text-success display-4"></i>
                    <h1 class="h3 mt-2">Devolución registrada</h1>
                    <p class="text-secondary">
                        El préstamo #{{id_prestamo}} fue devuelto correctamente.
                    </p>
                </div>

                <ul class="list-group list-group-flush mb-4">
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Fecha de vencimiento</span>
                        <strong>{{fecha resultado.fechaVencimiento}}</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Fecha de devolución</span>
                        <strong>{{fecha resultado.fechaDevolucion}}</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Días de atraso</span>
                        <strong>{{resultado.diasAtraso}}</strong>
                    </li>
                </ul>

                <div class="table-responsive mb-3">
                    <table class="table table-striped align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Código</th>
                                <th>Libro</th>
                                <th>Estado final</th>
                                <th class="text-center">Días de atraso</th>
                                <th class="text-end">Multa</th>
                            </tr>
                        </thead>

                        <tbody>
                            {{#each resultado.ejemplares}}
                            <tr>
                                <td class="fw-semibold">{{codigo_inventario}}</td>
                                <td>{{titulo}}</td>
                                <td><span class="badge text-bg-{{claseEstado estado_final}}">{{estado_final}}</span></td>
                                <td class="text-center">{{dias_atraso}}</td>
                                <td class="text-end">{{moneda multa}}</td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="fw-semibold">Total de multa</span>
                    <span class="fs-4 fw-bold {{#if resultado.totalMulta}}text-danger{{/if}}">{{moneda resultado.totalMulta}}</span>
                </div>

                {{#if resultado.totalMulta}}
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-1"></i>El préstamo registra una multa por atraso.
                </div>
                {{else}}
                <div class="alert alert-success">
                    <i class="bi bi-check2 me-1"></i>El préstamo no registra multa.
                </div>
                {{/if}}

                <div class="text-center">
                    <a href="/prestamos" class="btn btn-primary">
                        <i class="bi bi-arrow-left me-1"></i>Volver a préstamos
                    </a>
                </div>

            </div>
        </div>

    </div>
</div>
