{{#if totalPaginas}}
<nav aria-label="Paginación" class="mt-4">
    <ul class="pagination justify-content-center flex-wrap mb-2">
        {{#if puedeIrAnterior}}
        <li class="page-item">
            <a class="page-link" href="{{urlPaginaAnterior}}">
                <i class="bi bi-chevron-left"></i> Anterior
            </a>
        </li>
        {{else}}
        <li class="page-item disabled">
            <span class="page-link"><i class="bi bi-chevron-left"></i> Anterior</span>
        </li>
        {{/if}}

        {{#each paginas}}
        {{#if puntos}}
        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
        {{else if activa}}
        <li class="page-item active" aria-current="page">
            <span class="page-link">{{numero}}</span>
        </li>
        {{else}}
        <li class="page-item">
            <a class="page-link" href="{{url}}">{{numero}}</a>
        </li>
        {{/if}}
        {{/each}}

        {{#if puedeIrSiguiente}}
        <li class="page-item">
            <a class="page-link" href="{{urlPaginaSiguiente}}">
                Siguiente <i class="bi bi-chevron-right"></i>
            </a>
        </li>
        {{else}}
        <li class="page-item disabled">
            <span class="page-link">Siguiente <i class="bi bi-chevron-right"></i></span>
        </li>
        {{/if}}
    </ul>

    <p class="text-center text-secondary small mb-0">
        Página {{pagina}} de {{totalPaginas}}
    </p>
</nav>
{{/if}}
