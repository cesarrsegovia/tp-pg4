{{> encabezado titulo="Ejemplares" subtitulo="Copias físicas de cada libro y su estado" urlNuevo="/ejemplares/nuevo" textoNuevo="Nuevo ejemplar"}}

{{> buscador action="/ejemplares" placeholder="Buscar por código, libro o estado..."}}

<div class="card shadow-sm">
    <div class="card-body">
        {{#if ejemplares.length}}
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle" id="tabla-ejemplares">
                <thead class="table-dark">
                    <tr>
                        <th>Código</th>
                        <th>Libro</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    {{#each ejemplares}}
                    <tr>
                        <td class="fw-semibold">{{codigo_inventario}}</td>
                        <td>{{titulo}}</td>
                        <td>
                            <span class="badge text-bg-{{claseEstado estado}}">{{estado}}</span>
                        </td>
                        <td>
                            <div class="d-flex flex-wrap justify-content-end gap-2">
                                <a href="/prestamos/ejemplar/{{id_ejemplar}}" class="btn btn-sm btn-outline-info">
                                    <i class="bi bi-clock-history me-1"></i>Historial
                                </a>

                                <a href="/ejemplares/{{id_ejemplar}}/editar" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil-square me-1"></i>Editar
                                </a>

                                <form
                                    action="/ejemplares/{{id_ejemplar}}/eliminar"
                                    method="POST"
                                    data-confirmar="¿Querés eliminar el ejemplar {{codigo_inventario}}?">
{{> csrf}}
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash me-1"></i>Eliminar
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>

        {{else}}
        <div class="alert alert-info mb-0">
            <i class="bi bi-info-circle me-1"></i>{{#if buscar}}No se encontraron resultados para "{{buscar}}".{{else}}Todavía no hay ejemplares registrados.{{/if}}
        </div>
        {{/if}}
    </div>
</div>

{{> paginacion}}
