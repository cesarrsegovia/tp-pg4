<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">

        <div class="mb-4">
            <h1 class="h2 mb-1">Nuevo ejemplar</h1>
            <p class="text-secondary mb-0">Completá los datos para registrar una copia de un libro.</p>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                {{> errores}}

                <form action="/ejemplares" method="POST">
{{> csrf}}
                    <div class="row g-3">
                        <div class="col-12">
                            <label for="codigo_inventario" class="form-label">Código de inventario</label>
                            <input
                                type="text"
                                id="codigo_inventario"
                                name="codigo_inventario"
                                class="form-control"
                                maxlength="50"
                                value="{{datos.codigo_inventario}}"
                                required>
                        </div>

                        <div class="col-12">
                            <label for="id_libro" class="form-label">Libro</label>
                            <select id="id_libro" name="id_libro" class="form-select" required>
                                <option value="">Seleccione un libro</option>
                                {{#each libros}}
                                <option value="{{id_libro}}" {{#if (eq ../datos.id_libro id_libro)}}selected{{/if}}>
                                    {{titulo}}
                                </option>
                                {{/each}}
                            </select>
                        </div>

                        <div class="col-12">
                            <label for="estado" class="form-label">Estado inicial</label>
                            <select id="estado" name="estado" class="form-select" required>
                                <option value="">Seleccione un estado</option>
                                <option value="Disponible" {{#if (eq datos.estado 'Disponible')}}selected{{/if}}>Disponible</option>
                                <option value="Dañado" {{#if (eq datos.estado 'Dañado')}}selected{{/if}}>Dañado</option>
                                <option value="En mantenimiento" {{#if (eq datos.estado 'En mantenimiento')}}selected{{/if}}>En mantenimiento</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i>Guardar ejemplar
                        </button>

                        <a href="/ejemplares" class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg me-1"></i>Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>
