<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">Dashboard</h1>
        <p class="text-secondary mb-0">
            Resumen general de la biblioteca
        </p>
    </div>
</div>

<div class="row g-4 mb-4">

    <div class="col-md-6 col-lg-4 col-xl">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-secondary">Socios activos</h6>
                <h2 class="mb-0">{{resumen.socios_activos}}</h2>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4 col-xl">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-secondary">Libros</h6>
                <h2 class="mb-0">{{resumen.libros}}</h2>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4 col-xl">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-secondary">Ejemplares disponibles</h6>
                <h2 class="mb-0">{{resumen.ejemplares_disponibles}}</h2>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4 col-xl">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-secondary">Préstamos activos</h6>
                <h2 class="mb-0">{{resumen.prestamos_activos}}</h2>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4 col-xl">
        <div class="card shadow-sm h-100 border-danger-subtle">
            <div class="card-body">
                <h6 class="text-secondary">Préstamos vencidos</h6>
                <h2 class="mb-0 text-danger">{{resumen.prestamos_vencidos}}</h2>
            </div>
        </div>
    </div>

</div>

<div class="row g-4">

    <div class="col-lg-8">

        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-exclamation-triangle text-danger me-1"></i>Préstamos vencidos</h5>
            </div>

            <div class="card-body">

                {{#if prestamosVencidos.length}}

                    <div class="table-responsive">
                        <table class="table table-hover align-middle">

                            <thead class="table-dark">
                                <tr>
                                    <th>Préstamo</th>
                                    <th>Socio</th>
                                    <th>DNI</th>
                                    <th>Vencimiento</th>
                                    <th></th>
                                </tr>
                            </thead>

                            <tbody>

                                {{#each prestamosVencidos}}

                                    <tr>
                                        <td>#{{id_prestamo}}</td>

                                        <td>
                                            {{nombre}} {{apellido}}
                                        </td>

                                        <td>
                                            {{dni}}
                                        </td>

                                        <td>
                                            {{fecha fecha_vencimiento}}
                                        </td>

                                        <td>
                                            <a
                                                href="/prestamos/{{id_prestamo}}"
                                                class="btn btn-sm btn-outline-primary"
                                            >
                                                <i class="bi bi-eye me-1"></i>Ver detalle
                                            </a>
                                        </td>
                                    </tr>

                                {{/each}}

                            </tbody>

                        </table>
                    </div>

                {{else}}

                    <div class="alert alert-success mb-0">
                        No hay préstamos vencidos.
                    </div>

                {{/if}}

            </div>
        </div>

    </div>

    <div class="col-lg-4">

        <div class="card shadow-sm h-100">

            <div class="card-header">
                <h5 class="mb-0">Acciones rápidas</h5>
            </div>

            <div class="card-body d-grid gap-2">

                <a href="/prestamos/nuevo" class="btn btn-primary">
                    <i class="bi bi-plus-lg me-1"></i>Nuevo préstamo
                </a>

                <a href="/libros/nuevo" class="btn btn-outline-primary">
                    <i class="bi bi-journal-plus me-1"></i>Nuevo libro
                </a>

                <a href="/ejemplares/nuevo" class="btn btn-outline-primary">
                    <i class="bi bi-upc-scan me-1"></i>Nuevo ejemplar
                </a>

                <a href="/libros/catalogo" class="btn btn-outline-secondary">
                    <i class="bi bi-collection me-1"></i>Ver catálogo
                </a>

            </div>

        </div>

    </div>

</div>