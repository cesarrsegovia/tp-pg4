{{> encabezado titulo="Autores" subtitulo="Administración de autores de la biblioteca" urlNuevo="/autores/nuevo" textoNuevo="Nuevo autor"}}

{{> buscador action="/autores" placeholder="Buscar por nombre o apellido del autor..."}}

<div class="card shadow-sm">
    <div class="card-body">
        {{#if autores.length}}
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle" id="tabla-autores">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 5rem;">#</th>
                        <th>Apellido</th>
                        <th>Nombre</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    {{#each autores}}
                    <tr>
                        <td class="text-secondary">{{id_autor}}</td>
                        <td class="fw-semibold"><i class="bi bi-person text-secondary me-1"></i> {{apellido}}</td>
                        <td>{{nombre}}</td>
                        <td>
                            <div class="d-flex flex-wrap justify-content-end gap-2">
                                <a href="/autores/{{id_autor}}/editar" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil-square me-1"></i>Editar
                                </a>

                                <form
                                    action="/autores/{{id_autor}}/eliminar"
                                    method="POST"
                                    data-confirmar="¿Querés eliminar al autor {{nombre}} {{apellido}}?">
{{> csrf}}
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash me-1"></i>Eliminar
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>

        {{else}}
        <div class="alert alert-info mb-0">
            <i class="bi bi-info-circle me-1"></i>{{#if buscar}}No se encontraron resultados para "{{buscar}}".{{else}}Todavía no hay registros cargados.{{/if}}
        </div>
        {{/if}}
    </div>
</div>

{{> paginacion}}
