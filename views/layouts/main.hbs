<!DOCTYPE html>
<html lang="es" data-bs-theme="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Biblioteca</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    {{!-- Aplica el tema guardado antes de pintar para evitar parpadeos --}}
    <script>
        (function () {
            try {
                var tema = localStorage.getItem('tema');
                if (!tema) {
                    tema = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                }
                document.documentElement.setAttribute('data-bs-theme', tema);
            } catch (e) { }
        })();
    </script>
</head>

<body class="d-flex flex-column min-vh-100">

    <nav class="navbar navbar-expand-lg bg-dark shadow-sm" data-bs-theme="dark">
        <div class="container">

            <a class="navbar-brand fw-semibold" href="/">
                <i class="bi bi-book-half me-1"></i>
                Biblioteca
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarPrincipal"
                aria-controls="navbarPrincipal" aria-expanded="false" aria-label="Mostrar menú">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarPrincipal">

                {{#if usuario}}
                <ul class="navbar-nav me-auto">

                    <li class="nav-item">
                        <a class="nav-link {{activo seccion 'inicio'}}" href="/">
                            <i class="bi bi-speedometer2 me-1"></i>Inicio
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link {{activo seccion 'libros'}}" href="/libros">
                            <i class="bi bi-journal-text me-1"></i>Libros
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link {{activo seccion 'catalogo'}}" href="/libros/catalogo">
                            <i class="bi bi-collection me-1"></i>Catálogo
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link {{activo seccion 'ejemplares'}}" href="/ejemplares">
                            <i class="bi bi-upc-scan me-1"></i>Ejemplares
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link {{activo seccion 'socios'}}" href="/socios">
                            <i class="bi bi-people me-1"></i>Socios
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link {{activo seccion 'prestamos'}}" href="/prestamos">
                            <i class="bi bi-arrow-left-right me-1"></i>Préstamos
                        </a>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle {{activo seccion 'catalogos'}}" href="#" role="button"
                            data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-tags me-1"></i>Catálogos
                        </a>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" href="/categorias">
                                    <i class="bi bi-bookmarks me-2"></i>Categorías
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="/autores">
                                    <i class="bi bi-person-lines-fill me-2"></i>Autores
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="/editoriales">
                                    <i class="bi bi-building me-2"></i>Editoriales
                                </a>
                            </li>
                        </ul>
                    </li>

                </ul>
                {{else}}
                <div class="me-auto"></div>
                {{/if}}

                <div class="d-flex align-items-center gap-2">

                    <button type="button" id="tema-toggle" class="btn btn-outline-light btn-sm"
                        aria-label="Cambiar entre modo claro y oscuro" title="Cambiar tema">
                        <i class="bi bi-moon-stars-fill" id="tema-icono"></i>
                    </button>

                    {{#if usuario}}
                    <div class="dropdown">
                        <button type="button" class="btn btn-outline-light btn-sm dropdown-toggle {{activo seccion 'usuarios'}}"
                            data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle me-1"></i>{{usuario.nombre}} {{usuario.apellido}}
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item" href="/usuarios/nuevo">
                                    <i class="bi bi-person-plus me-2"></i>Nuevo usuario
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form action="/logout" method="POST">
{{> csrf}}
                                    <button type="submit" class="dropdown-item">
                                        <i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                    {{/if}}

                </div>

            </div>

        </div>
    </nav>

    <main class="container py-4 flex-grow-1">

        {{#each success}}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>{{this}}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
        {{/each}}

        {{#each error}}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>{{this}}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
        {{/each}}

        {{{body}}}

    </main>

    <footer class="border-top py-3 text-center text-secondary small">
        Sistema de gestión de biblioteca
    </footer>

    {{!-- Modal de confirmación reutilizable (formularios con data-confirmar) --}}
    <div class="modal fade" id="modalConfirmar" tabindex="-1" aria-labelledby="modalConfirmarTitulo" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="modalConfirmarTitulo">
                        <i class="bi bi-exclamation-triangle text-danger me-2"></i>Confirmar acción
                    </h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body" id="modalConfirmarMensaje"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg me-1"></i>Cancelar
                    </button>
                    <button type="button" class="btn btn-danger" id="modalConfirmarAceptar">
                        <i class="bi bi-check-lg me-1"></i>Confirmar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        (function () {
            // Modo claro / oscuro
            var raiz = document.documentElement;
            var icono = document.getElementById('tema-icono');

            function actualizarIcono() {
                var oscuro = raiz.getAttribute('data-bs-theme') === 'dark';
                icono.className = oscuro ? 'bi bi-sun-fill' : 'bi bi-moon-stars-fill';
            }

            document.getElementById('tema-toggle').addEventListener('click', function () {
                var nuevo = raiz.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
                raiz.setAttribute('data-bs-theme', nuevo);
                try { localStorage.setItem('tema', nuevo); } catch (e) { }
                actualizarIcono();
            });

            actualizarIcono();

            // Confirmación de acciones con modal: <form data-confirmar="mensaje">
            var modalElemento = document.getElementById('modalConfirmar');
            var modal = new bootstrap.Modal(modalElemento);
            var formularioPendiente = null;

            document.addEventListener('submit', function (evento) {
                var formulario = evento.target;

                if (formulario.dataset && formulario.dataset.confirmar) {
                    evento.preventDefault();
                    formularioPendiente = formulario;
                    document.getElementById('modalConfirmarMensaje').textContent = formulario.dataset.confirmar;
                    modal.show();
                }
            });

            document.getElementById('modalConfirmarAceptar').addEventListener('click', function () {
                if (formularioPendiente) {
                    var formulario = formularioPendiente;
                    formularioPendiente = null;
                    modal.hide();
                    formulario.submit();
                }
            });

            // Buscadores del servidor: al vaciar el campo con la "x" nativa, se quita la búsqueda.
            document.querySelectorAll('input[type="search"]').forEach(function (campo) {
                campo.addEventListener('search', function () {
                    var habiaBusqueda = campo.defaultValue !== '';

                    if (campo.value === '' && habiaBusqueda && campo.form) {
                        window.location.href = campo.form.getAttribute('action') || window.location.pathname;
                    }
                });
            });

            // Buscador en tablas: <input data-filtro-tabla="#idTabla">
            document.querySelectorAll('[data-filtro-tabla]').forEach(function (campo) {
                var tabla = document.querySelector(campo.dataset.filtroTabla);
                if (!tabla) { return; }

                var vacio = document.querySelector(campo.dataset.filtroVacio || '#sin-resultados');

                campo.addEventListener('input', function () {
                    var texto = campo.value.trim().toLowerCase();
                    var visibles = 0;

                    tabla.querySelectorAll('tbody tr').forEach(function (fila) {
                        var coincide = fila.textContent.toLowerCase().indexOf(texto) !== -1;
                        fila.classList.toggle('d-none', !coincide);
                        if (coincide) { visibles++; }
                    });

                    if (vacio) { vacio.classList.toggle('d-none', visibles !== 0); }
                });
            });
        })();
    </script>

</body>

</html>
