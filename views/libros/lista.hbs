{{> encabezado titulo="Libros" subtitulo="Administración de libros de la biblioteca" urlNuevo="/libros/nuevo" textoNuevo="Nuevo libro"}}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form action="/libros" method="GET" class="row g-3 align-items-end">
            <div class="col-md-8">
                <label for="buscar" class="form-label">Buscar libro</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input
                        type="text"
                        name="buscar"
                        id="buscar"
                        class="form-control"
                        placeholder="Título, ISBN, autor o categoría"
                        value="{{buscar}}">
                </div>
            </div>

            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search me-1"></i>Buscar
                </button>

                <a href="/libros" class="btn btn-outline-secondary">
                    <i class="bi bi-x-lg me-1"></i>Limpiar
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        {{#if libros.length}}
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ISBN</th>
                        <th>Título</th>
                        <th>Autor</th>
                        <th>Categoría</th>
                        <th>Editorial</th>
                        <th>Año</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    {{#each libros}}
                    <tr>
                        <td class="text-nowrap">{{isbn}}</td>
                        <td class="fw-semibold">{{titulo}}</td>
                        <td>{{autor}}</td>
                        <td>{{categoria}}</td>
                        <td>{{editorial}}</td>
                        <td>{{anio_publicacion}}</td>
                        <td>
                            <div class="d-flex flex-wrap justify-content-end gap-2">
                                <a href="/libros/{{id_libro}}/editar" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil-square me-1"></i>Editar
                                </a>

                                <a href="/libros/{{id_libro}}" class="btn btn-sm btn-outline-info">
                                    <i class="bi bi-eye me-1"></i>Ver
                                </a>

                                <form
                                    action="/libros/{{id_libro}}/eliminar"
                                    method="POST"
                                    data-confirmar="¿Querés eliminar el libro {{titulo}}?">
{{> csrf}}
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash me-1"></i>Eliminar
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="alert alert-info mb-0">
            <i class="bi bi-info-circle me-1"></i>{{#if buscar}}No se encontraron libros para "{{buscar}}".{{else}}Todavía no hay libros registrados.{{/if}}
        </div>
        {{/if}}
    </div>
</div>

{{> paginacion}}
