{{> encabezado titulo="Catálogo de libros" subtitulo="Disponibilidad de ejemplares por título"}}

<div class="card shadow-sm">
    <div class="card-body">
        {{#if libros.length}}
        <div class="row mb-3">
            <div class="col-md-6 col-lg-4">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input
                        type="search"
                        class="form-control"
                        placeholder="Buscar por título, autor o categoría..."
                        aria-label="Buscar"
                        data-filtro-tabla="#tabla-catalogo">
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle" id="tabla-catalogo">
                <thead class="table-dark">
                    <tr>
                        <th>Título</th>
                        <th>Autor</th>
                        <th>Categoría</th>
                        <th class="text-center">Disponibles</th>
                        <th class="text-center">Totales</th>
                        <th class="text-end">Detalle</th>
                    </tr>
                </thead>

                <tbody>
                    {{#each libros}}
                    <tr>
                        <td class="fw-semibold">
                            <a href="/libros/{{id_libro}}" class="link-body-emphasis link-underline-opacity-25 link-underline-opacity-100-hover">{{titulo}}</a>
                        </td>
                        <td>{{autor}}</td>
                        <td>{{categoria}}</td>
                        <td class="text-center">
                            {{#if ejemplares_disponibles}}
                            <span class="badge text-bg-success">{{ejemplares_disponibles}}</span>
                            {{else}}
                            <span class="badge text-bg-danger">0</span>
                            {{/if}}
                        </td>
                        <td class="text-center">{{ejemplares_totales}}</td>
                        <td class="text-end">
                            <a href="/libros/{{id_libro}}" class="btn btn-sm btn-outline-info">
                                <i class="bi bi-eye me-1"></i>Ver detalle
                            </a>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>

        <div class="alert alert-warning d-none mb-0" id="sin-resultados">
            <i class="bi bi-search me-1"></i>No hay resultados para la búsqueda.
        </div>
        {{else}}
        <div class="alert alert-info mb-0">
            <i class="bi bi-info-circle me-1"></i>Todavía no hay libros en el catálogo.
        </div>
        {{/if}}
    </div>
</div>

<div class="mt-3">
    <a href="/libros" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Volver a libros
    </a>
</div>
