{{> encabezado titulo=libro.titulo subtitulo="Detalle del libro y estado de sus ejemplares"}}

<div class="row g-4">

    <div class="col-lg-5">
        <div class="card shadow-sm h-100">
            <div class="card-header">
                <h2 class="h5 mb-0"><i class="bi bi-journal-text me-1"></i>Datos del libro</h2>
            </div>

            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">ISBN</dt>
                    <dd class="col-sm-8">{{libro.isbn}}</dd>

                    <dt class="col-sm-4">Autor</dt>
                    <dd class="col-sm-8">{{libro.autor}}</dd>

                    <dt class="col-sm-4">Categoría</dt>
                    <dd class="col-sm-8">{{libro.categoria}}</dd>

                    <dt class="col-sm-4">Editorial</dt>
                    <dd class="col-sm-8">{{libro.editorial}}</dd>

                    <dt class="col-sm-4">Año</dt>
                    <dd class="col-sm-8 mb-0">{{libro.anio_publicacion}}</dd>
                </dl>
            </div>

            <div class="card-footer d-flex flex-wrap gap-3">
                <span>
                    <span class="badge text-bg-success">{{disponibles}}</span> disponibles
                </span>
                <span>
                    <span class="badge text-bg-secondary">{{totalEjemplares}}</span> en total
                </span>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card shadow-sm h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2 class="h5 mb-0"><i class="bi bi-upc-scan me-1"></i>Ejemplares</h2>
                <a href="/ejemplares/nuevo" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-plus-lg me-1"></i>Nuevo ejemplar
                </a>
            </div>

            <div class="card-body">
                {{#if ejemplares.length}}
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Código</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            {{#each ejemplares}}
                            <tr>
                                <td class="fw-semibold">{{codigo_inventario}}</td>
                                <td>
                                    <span class="badge text-bg-{{claseEstado estado}}">{{estado}}</span>
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap justify-content-end gap-2">
                                        <a href="/prestamos/ejemplar/{{id_ejemplar}}" class="btn btn-sm btn-outline-info">
                                            <i class="bi bi-clock-history me-1"></i>Historial
                                        </a>
                                        <a href="/ejemplares/{{id_ejemplar}}/editar" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil-square me-1"></i>Editar
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
                {{else}}
                <div class="alert alert-info mb-0">
                    <i class="bi bi-info-circle me-1"></i>Este libro todavía no tiene ejemplares registrados.
                </div>
                {{/if}}
            </div>
        </div>
    </div>

</div>

<div class="d-flex flex-wrap gap-2 mt-4">
    <a href="/libros/catalogo" class="btn btn-outline-secondary">
        <i class="bi bi-collection me-1"></i>Volver al catálogo
    </a>
    <a href="/libros" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Volver a libros
    </a>
    <a href="/libros/{{libro.id_libro}}/editar" class="btn btn-outline-primary">
        <i class="bi bi-pencil-square me-1"></i>Editar libro
    </a>
</div>
