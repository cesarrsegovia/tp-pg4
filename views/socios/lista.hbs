{{> encabezado titulo="Socios" subtitulo="Administración de socios de la biblioteca" urlNuevo="/socios/nuevo" textoNuevo="Nuevo socio"}}

{{> buscador action="/socios" placeholder="Buscar por nombre, apellido, DNI o email..."}}

<div class="card shadow-sm">
    <div class="card-body">
        {{#if socios.length}}
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle" id="tabla-socios">
                <thead class="table-dark">
                    <tr>
                        <th>Nombre y apellido</th>
                        <th>DNI</th>
                        <th>Email</th>
                        <th>Teléfono</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    {{#each socios}}
                    <tr>
                        <td class="fw-semibold">{{nombre}} {{apellido}}</td>
                        <td>{{dni}}</td>
                        <td>{{email}}</td>
                        <td>{{#if telefono}}{{telefono}}{{else}}—{{/if}}</td>

                        <td>
                            {{#if esActivo}}
                                <span class="badge text-bg-success">Activo</span>
                            {{else}}
                                <span class="badge text-bg-secondary">Inactivo</span>
                            {{/if}}
                        </td>

                        <td>
                            <div class="d-flex flex-wrap justify-content-end gap-2">
                                <a href="/prestamos/socio/{{id_socio}}" class="btn btn-sm btn-outline-info">
                                    <i class="bi bi-clock-history me-1"></i>Historial
                                </a>

                                <a href="/socios/{{id_socio}}/editar" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil-square me-1"></i>Editar
                                </a>

                                <form
                                    action="/socios/{{id_socio}}/eliminar"
                                    method="POST"
                                    data-confirmar="¿Querés eliminar al socio {{nombre}} {{apellido}}?">
{{> csrf}}
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash me-1"></i>Eliminar
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>

        {{else}}
        <div class="alert alert-info mb-0">
            <i class="bi bi-info-circle me-1"></i>{{#if buscar}}No se encontraron resultados para "{{buscar}}".{{else}}Todavía no hay socios registrados.{{/if}}
        </div>
        {{/if}}
    </div>
</div>

{{> paginacion}}
