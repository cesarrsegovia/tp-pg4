
<div class="mb-4">
    <h1 class="h2">Editar socio</h1>
    <p class="text-secondary">
        Modificá los datos del socio seleccionado.
    </p>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        {{> errores}}

        <form action="/socios/{{socio.id_socio}}" method="POST">
{{> csrf}}
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="nombre" class="form-label">
                        Nombre
                    </label>
                    <input
                        type="text"
                        id="nombre"
                        name="nombre"
                        class="form-control"
                        maxlength="100"
                        value="{{socio.nombre}}"
                        required>
                </div>

                <div class="col-md-6">
                    <label for="apellido" class="form-label">
                        Apellido
                    </label>
                    <input
                        type="text"
                        id="apellido"
                        name="apellido"
                        class="form-control"
                        maxlength="100"
                        value="{{socio.apellido}}"
                        required>
                </div>

                <div class="col-md-6">
                    <label for="dni" class="form-label">
                        DNI
                    </label>
                    <input
                        type="text"
                        id="dni"
                        name="dni"
                        class="form-control"
                        maxlength="20"
                        value="{{socio.dni}}"
                        required>
                </div>

                <div class="col-md-6">
                    <label for="email" class="form-label">
                        Email
                    </label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        class="form-control"
                        maxlength="150"
                        value="{{socio.email}}"
                        required>
                </div>

                <div class="col-md-6">
                    <label for="telefono" class="form-label">
                        Teléfono
                    </label>
                    <input
                        type="text"
                        id="telefono"
                        name="telefono"
                        class="form-control"
                        maxlength="30"
                        pattern="[0-9+\(\)\.\s\-]+"
                        title="Solo números, espacios y los símbolos + ( ) - ."
                        value="{{socio.telefono}}">
                </div>

                <div class="col-md-6">
                    <label for="estado" class="form-label">
                        Estado
                    </label>
                    <select
                        id="estado"
                        name="estado"
                        class="form-select"
                        required>
                        {{#each estados}}
                            <option
                                value="{{valor}}"
                                {{#if seleccionado}}selected{{/if}}>
                                {{valor}}
                            </option>
                        {{/each}}
                    </select>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save me-1"></i>Guardar cambios
                </button>

                <a href="/socios" class="btn btn-outline-secondary">
                    <i class="bi bi-x-lg me-1"></i>Cancelar
                </a>
            </div>
        </form>
    </div>
</div>
